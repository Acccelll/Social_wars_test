{
  "compilerOptions": {
    "target":"ES2022",
    "lib":["ES2022"],
    "module":"NodeNext",
    "moduleResolution":"NodeNext",
    "strict":true,
    "noUncheckedIndexedAccess":true,
    "noEmitOnError":true,
    "rootDir":"src",
    "outDir":"dist",
    "declaration":true,
    "sourceMap":true,
    "forceConsistentCasingInFileNames":true,
    "skipLibCheck":true
  },
  "include":["src/**/*.ts"]
}
